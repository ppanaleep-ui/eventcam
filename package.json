{
  "name": "eventcam",
  "version": "1.0.0",
  "private": true,
  "description": "EventCam — a digital disposable camera web app for events. Guests scan a QR code, snap retro-filtered photos in the browser (no app download), and everything lands in one live shared album. Built to handle 2000+ concurrent guests.",
  "type": "module",
  "workspaces": [
    "client"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm -w client run dev",
    "build": "npm -w client run build",
    "start": "cross-env NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "archiver": "^7.0.1",
    "better-sqlite3": "^11.8.1",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "ioredis": "^5.11.1",
    "multer": "^2.2.0",
    "nanoid": "^5.0.9",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3"
  }
}
