# Copy to .env and adjust. All values are optional; sensible defaults apply.

# Port the server listens on.
PORT=3000

# Where the SQLite database and uploaded photos are stored.
# Point this at a persistent volume in production.
DATA_DIR=./data

# Public https origin used to build QR / invite links.
# e.g. https://eventcam.example.com  (leave blank to infer from the request)
PUBLIC_URL=

# Upload guard rails (bytes). Real image processing happens on the guest's
# device, so these are just safety limits for the raw bytes accepted.
MAX_FULL_BYTES=12582912
MAX_THUMB_BYTES=2097152
ALLOWED_MIME=image/jpeg,image/png,image/webp

# Album page size.
PAGE_SIZE=60

# Per-IP rate limits (guests each have their own IP, so these are per-person).
# Set a max to 0 to disable that limiter — handy for single-IP load testing.
UPLOAD_RATE_MAX=40
UPLOAD_RATE_WINDOW_MS=60000
CREATE_RATE_MAX=60

# ─── Scaling backends (all optional; unset = local dev defaults) ────────────
# Leave these blank to use SQLite + local filesystem + in-process live updates.

# Postgres — set to use it instead of SQLite (recommended for multi-instance).
# DATABASE_URL=postgres://eventcam:eventcam@localhost:5432/eventcam
# PGSSL=false
# PG_POOL_MAX=10

# Redis — fan out live (SSE) updates across multiple app instances.
# REDIS_URL=redis://localhost:6379

# S3-compatible object storage — set S3_BUCKET to use it instead of local disk.
# Works with AWS S3, Cloudflare R2, Backblaze B2, MinIO, etc.
# S3_BUCKET=eventcam
# S3_REGION=us-east-1
# S3_ENDPOINT=            # e.g. https://<acct>.r2.cloudflarestorage.com (blank for AWS)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false   # true for MinIO
# S3_PUBLIC_BASE=         # CDN/base URL the browser fetches photos from
