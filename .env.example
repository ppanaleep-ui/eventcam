# Copy to .env and fill in.
DATABASE_URL="file:./dev.db"

# Session signing secret — generate a long random string for production.
SESSION_SECRET="change-me-to-a-long-random-string"

# Public base URL used to build QR codes and shareable links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Slip verification (optional) ---
# "easyslip" enables real Thai bank transfer-slip verification via EasySlip.
# Leave empty to accept slips without verification.
SLIP_VERIFY_PROVIDER=""
EASYSLIP_API_TOKEN=""

# LINE Messaging API credentials are configured per-event in the dashboard settings:
#   - Channel access token (long-lived)
#   - Destination userId / groupId to receive push notifications
