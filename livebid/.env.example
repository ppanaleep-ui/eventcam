# Copy to .env and fill in.

# PostgreSQL connection string. `docker compose up` provides this one:
DATABASE_URL="postgresql://livebid:livebid@localhost:5432/livebid?schema=public"

# Session signing secret — generate a long random string for production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string-please"

# Public base URL of the deployment (used for share links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Where product photos and top-up slips are written. On a container host point
# this at a mounted volume/disk, otherwise uploads vanish on the next deploy.
STORAGE_DIR=""

# --- Wallet / marketplace economics ---
# Platform commission taken from every sale, in percent.
PLATFORM_FEE_PERCENT="10"
# PromptPay account (Thai mobile number or 13-digit national ID) that wallet
# top-ups are paid into. Used to render the top-up QR code.
PROMPTPAY_ID="0812345678"
# When "true", a top-up with an uploaded slip is approved automatically
# (handy for demos/tests). In production leave it false and approve in /admin.
AUTO_APPROVE_TOPUP="false"

# --- Admin ---
# Accounts with these e-mails get the admin console (/admin) for approving
# top-ups and paying out withdrawals. Comma-separated.
ADMIN_EMAILS="admin@livebid.app"

# --- Tests ---
# Database used by `npm run test:flow` (it is wiped on every run).
TEST_DATABASE_URL="postgresql://livebid:livebid@localhost:5432/livebid_test?schema=public"
